# Python and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local configuration and credentials
.env
.env.*
*.pem
*.key
*.token
credentials.json
secrets.json

# Local runtime data
*.sqlite3
*.db
logs/
tmp/
backups/

# Agent handoff and validation material should stay outside this Skill repo
handoffs/
handoff/
validation/
config.yaml

# Ledger runtime data (default local-backend location is outside repo; guard anyway)
*.jsonl
*.jsonl.lock

# Machine-specific Qoder/ZCode entry and offline test artifacts
scripts/local-entry.json
scripts/zcode-entry.json
scripts/codebuddy-entry.json
scripts/quota-routes.json
tests/*-run-*/

# Private review inputs/outputs kept on the local machine only
review-input/
review-output/
