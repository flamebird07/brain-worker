# brain-worker 用户配置示例：复制为 config.yaml 后按需修改。
# config.yaml 已加入 .gitignore，只存本地，不进仓库。
#
# 使用场景：
# - GPT 桌面（Windows）原有人工转发用法不需要本文件：GPT 做主脑，直接按
#   human-relay 生成提示词，由用户转发外部桌面 Agent 并上传原始报告。
# - Linux 场景分别记录宿主/运行环境与主脑驱动；二者可以形成嵌套架构，例如
#   在 muse 宿主环境中调用 codex-cli 作为主脑驱动。本仓库不假定宿主的厂商、
#   安装命令或专有 API。
# - 未创建 config.yaml 时，任何平台都按 human-relay + local 台账执行。
#
runtime_environment: muse  # 宿主/运行环境名称，不假定厂商与专有 API
brain_driver: codex-cli    # 主脑驱动：muse | codex-cli
# 执行方式：2 选 1；默认 human-relay（零 API 配置，人工转发）
execution: human-relay  # 可选：human-relay | api-direct；api-direct 必须由用户显式选择且对应适配器已通过预检
# 台账后端：2 选 1（默认 local，开箱即用；feishu 需自行配置，见 SKILL.md“飞书后端接入（可选）”）
ledger: local  # 可选：local | feishu
# api-direct 下发配置：仅当 execution 显式设为 api-direct 时才需要填写。
# 以下全为中性占位值，替换为你自己环境中实际可用的受控工具与接口说明。
# 注意：当前配置由主脑按 SKILL.md 解释执行，仓库没有自动消费配置的调度器；
# 本文件不构成已实现的自动调用链承诺。异常处理（超时/失败/中断/报告缺失）
# 按 SKILL.md“执行方式”一节执行。
worker:
  api_direct:
    # 四项可以是命令模板，也可以是适配器文档中明确的等价接口；占位符必须由适配器安全替换。
    dispatch: "python /path/to/your/controlled_tool.py dispatch --request {request_file}"
    poll: "python /path/to/your/controlled_tool.py poll --task-id {task_id}"
    events: "python /path/to/your/controlled_tool.py events --task-id {task_id} --after {event_cursor}"
    cancel: "python /path/to/your/controlled_tool.py cancel --task-id {task_id}"
    model: "<your-worker-model>"
    protocol:
      output_format: json       # 必须为机器可读输出
      task_id_field: task_id    # dispatch 返回的非空任务标识字段
      status_field: status
      event_id_field: event_id  # 或能稳定去重和追溯的等价序号字段
      terminal_states:
        succeeded: [completed]
        failed: [failed]
        cancelled: [cancelled]
      error_code_field: error.code
      error_message_field: error.message
      timeout_behavior: return_timeout_without_cancel  # 超时不自动表示失败或取消
    poll_interval_sec: 20
    poll_timeout_sec: 1800
